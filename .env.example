# Uzum Seller API (ichki/norasmiy - DevTools orqali aniqlangan)
UZUM_API_BASE_URL=https://api-seller.uzum.uz/api/seller

# Tavsiya etiladi: login/parol beriladi, token avtomatik (har ~4 kunda)
# o'zi yangilanadi, qo'lda DevTools'dan olib qo'yish shart emas.
UZUM_USERNAME=your_uzum_seller_email_here
UZUM_PASSWORD=your_uzum_seller_password_here

# Zaxira variant: login/parol berilmasa, shu yerga DevTools orqali qo'lda
# olingan sessiya tokenini qo'yish mumkin (muddati tugaganda qo'lda yangilanadi).
# Qanday olish: seller.uzum.uz > Отзывы > F12 > Network > Fetch/XHR >
# "product-reviews" so'rovi > Headers > Request Headers > Authorization
# (faqat "Bearer " so'zidan keyingi qismini oling)
UZUM_API_KEY=your_uzum_session_token_here

# Bir nechta do'kon bo'lsa, vergul bilan ajrating: 111,222,333
UZUM_SHOP_IDS=your_shop_id_1,your_shop_id_2,your_shop_id_3

# Claude (Anthropic) API - platform.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL_DRAFTER=claude-sonnet-5
CLAUDE_MODEL_REVIEWER=claude-sonnet-5

# Telegram Bot (@BotFather orqali yaratiladi)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Reviewer javobni necha marta qayta yozdirishi mumkinligi
MAX_REVISIONS=2

# Har bir 'draft' ishga tushirishda ko'pi bilan nechta sharh qayta ishlansin
MAX_REVIEWS_PER_RUN=5
